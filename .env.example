# DSN_API_KEY: Server-side API key for DSN Technology Payment Gateway (X-API-Key)
# Configure this in AI Studio Secrets or your server environment. Never expose in frontend.
DSN_API_KEY=""

# DSN_USER_ID: Official DSN Merchant User ID
DSN_USER_ID="DSN-0036"

# SESSION_SECRET: Secret key used to sign session tokens
SESSION_SECRET="change-this-to-a-long-random-secret"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
